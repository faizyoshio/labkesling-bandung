# ========================================================
# CONTOH VARIABEL LINGKUNGAN (ENVIRONMENT VARIABLES)
# Salin berkas ini menjadi .env untuk lokal, atau masukkan
# variabel di bawah ke Dashboard Vercel -> Project Settings -> Environment Variables.
# ========================================================

# Identitas Kampus & Laboratorium
VITE_LAB_NAME=Laboratorium Terpadu Kesehatan Lingkungan
VITE_CAMPUS_NAME=Poltekkes Kemenkes Bandung
VITE_DEPARTMENT_NAME=Jurusan Kesehatan Lingkungan (Sanitasi)
VITE_LOGO_URL=/logo-poltekkes-bandung.png

# Kontak WhatsApp Tujuan Pengajuan Peminjaman (format internasional: 628xxxxxxxxxx)
VITE_LAB_WHATSAPP_NUMBER=628xxxxxxxxxx
VITE_ADMIN_NAME=Nama Admin PLP (PLP)

# Jadwal Layanan & Lokasi Laboratorium
VITE_OPERATING_HOURS=Senin - Jumat: 08:00 - 16:00 WIB (Kampus Cimahi)
VITE_LAB_LOCATION=Gedung Laboratorium Terpadu Kesling, Kampus Cimahi

# Hash SHA-256 Password Akses Log Pinjam
VITE_LOG_PASSWORD_HASH=masukkan_sha256_hash_password_di_sini
